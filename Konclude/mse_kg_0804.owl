        <Literal>SIO</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo:RO_0002351</AbbreviatedIRI>
        <Literal xml:lang="en">has member</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <AbbreviatedIRI>obo:RO_0002352</AbbreviatedIRI>
        <Literal>inverse of has input</Literal>
    </AnnotationAssertion>
