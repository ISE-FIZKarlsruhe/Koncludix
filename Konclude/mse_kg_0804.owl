        <AbbreviatedIRI>obo:RO_0000053</AbbreviatedIRI>
        <Literal xml:lang="en">this apple is bearer of this red color</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000112"/>
        <AbbreviatedIRI>obo:RO_0000053</AbbreviatedIRI>
        <Literal xml:lang="en">this vase is bearer of this fragility</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <AbbreviatedIRI>obo:RO_0000053</AbbreviatedIRI>
        <Literal xml:lang="en">Inverse of characteristic_of</Literal>
    </AnnotationAssertion>
