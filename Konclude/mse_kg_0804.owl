        <AnnotationProperty abbreviatedIRI="skos:example"/>
        <AbbreviatedIRI>ontology:NFDI_0000186</AbbreviatedIRI>
        <Literal>Java, Ruby, C++, Perl, PHP</Literal>
    </AnnotationAssertion>
