        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>ontology:NFDI_0000210</AbbreviatedIRI>
        <Literal xml:lang="en">storage service</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
