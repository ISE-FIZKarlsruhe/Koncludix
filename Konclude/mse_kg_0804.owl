        <AbbreviatedIRI>obo:IAO_8000001</AbbreviatedIRI>
        <Literal xml:lang="en">An ontology module that comprises only of asserted axioms local to the ontology, excludes import directives, and excludes axioms or declarations from external ontologies.</Literal>
