        <AnnotationProperty abbreviatedIRI="owl:deprecated"/>
        <AbbreviatedIRI>mwo:MWO_0001057</AbbreviatedIRI>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#boolean">true</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:example"/>
        <AbbreviatedIRI>mwo:MWO_0001057</AbbreviatedIRI>
        <Literal>Examples include DFT simulation datasets, molecular dynamics (MD) trajectory files, and phase-field modeling results.</Literal>
    </AnnotationAssertion>
