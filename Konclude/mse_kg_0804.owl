    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174533026528321</IRI>
        <Literal>The Elemental Multiperspective Material Ontology (EMMO) is the result of a multidisciplinary effort within the EMMC, aimed at the development of a standard representational ontology framework based on current materials modelling and characterization knowledge.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174533026528322</IRI>
        <Literal>A materials ontology to support data Publication involving nanomaterials and metamaterials.</Literal>
