        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541797019219"/>
        <Literal>Mat-o-Lab: Fraunhofer Alliance MATERIALS and BAM approach to digitalize research results and workflows</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17454179701922"/>
        <Literal>Atomic structure + chemical complexity. Defect phase diagram and relation to material properties.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541797019220"/>
        <Literal>Mat-o-Lab: Fraunhofer Alliance MATERIALS and BAM approach to digitalize research results and workflows</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17454179701923"/>
        <Literal>Functional materials. Investigate magnetoelectric sensor approaches. Magnetic noise of ME sensors, influence of microstructure</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17454179701924"/>
        <Literal>Developing magnetic materials for future energy conversion technologies.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17454179701925"/>
        <Literal>Modeling of oxygen-free production. Influence of oxide layers on the physical properties of the bonding of composites. Focus on tribological phenomena and cold pressure welding processes</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17454179701926"/>
        <Literal>Image-based prediction of the material properties of stochastic microstructures</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17454179701927"/>
        <Literal>Develop new functional material systems for environmental and energy technologies</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
