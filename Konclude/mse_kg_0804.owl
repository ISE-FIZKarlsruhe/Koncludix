        <AnnotationProperty abbreviatedIRI="skos:editorialNote"/>
        <AbbreviatedIRI>ontology:NFDI_0000215</AbbreviatedIRI>
        <Literal xml:lang="en">A technology, e.g. a web application or a programming framework used in a resource.</Literal>
    </AnnotationAssertion>
