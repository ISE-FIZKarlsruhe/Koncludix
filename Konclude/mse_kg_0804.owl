        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17453302652839</IRI>
        <Literal>This Project collabration gathers the working documents used to design the specifications of the Electronic Structure Common Data Format (ESCDF), an initiative of the Electronic Structure Library (ESL) Contributors.</Literal>
    </AnnotationAssertion>
