    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001008"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17453210360135"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#anyURI">https://gitlab.mpcdf.mpg.de/nomad-lab/nomad-FAIR</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001008"/>
