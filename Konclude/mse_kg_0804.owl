    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>https://w3id.org/pmd/co/PMD_0025001</IRI>
        <Literal xml:lang="en">Composition is a morphological quality describing the types and proportions of compounds (but not chemical elements) present in a portion of matter.</Literal>
    </AnnotationAssertion>
