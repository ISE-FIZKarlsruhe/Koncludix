        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17463807930071</IRI>
        <Literal>Support the digital transformation of materials science through a community-driven process; Monitoring, analysis, feedback of the current state in the community</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17463807930072</IRI>
        <Literal>Provision of a digital materials environment (DME) to represent materials data and MatWerk-specific metadata; Provide services for easy storage, sharing, searching, and analysis of data and metadata; Ensure integrity, provenance, and authorship of data (FAIR principles)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17463807930073</IRI>
        <Literal>Standardization of materials ontology, including individualized materials ontologies for homegrown tools and workflows; Implementation of a knowledge graph to retrieve data based on their metadata</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17463807930074</IRI>
        <Literal>Ensure active participation and lively exchange of ideas, opinions, and experiences among researchers and associated stakeholders in the MSE community; Provide and conduct education and training for researchers, technical professionals, students; Planned TA-CI activities, including creating collaborative platforms, interactive workshops, and annual conferences</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17463807930075</IRI>
        <Literal>Development of a software framework; Creation, standardization, and implementation of scientific workflows, automated protocols for experiments, simulation studies, etc.</Literal>
    </AnnotationAssertion>
