    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250431</IRI>
        <Literal>various materials / digital lab book, workflow management in the lab, knowledge system</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250432</IRI>
        <Literal>Long fiber reinforced polymers (thermoset and thermoplastic materials) / Real process chain is modeled and optimized by digital twin which is based on multi-scale characterization and simulation</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250433</IRI>
