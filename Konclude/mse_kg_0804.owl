        <IRI>https://nfdi.fiz-karlsruhe.de/matwerk/msekg/177486407706012</IRI>
        <Literal>grain boundary segregation</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>https://nfdi.fiz-karlsruhe.de/matwerk/msekg/177486407706013</IRI>
        <Literal>First-principles calculations</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
