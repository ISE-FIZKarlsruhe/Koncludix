        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174516135982016"/>
        <Literal>nudged elastic band</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174516135982017"/>
