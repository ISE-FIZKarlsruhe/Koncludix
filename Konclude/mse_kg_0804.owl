    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250434</IRI>
        <Literal>Independent of a specific material/methodology. Supports teaching with a focus on using data science methods in MSE.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250435</IRI>
        <Literal>Mainly metallic materials, e.g. steels, aluminium alloys, Ti-6-4 / Atom Probe Tomography, nanoCT, FIB/SEM Tomography, Metallographic Serial Sectioning, Mechanical FE Simulation, Material Modeling.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250436</IRI>
