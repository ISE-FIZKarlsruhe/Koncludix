    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>obo:BFO_0000003</AbbreviatedIRI>
        <Literal xml:lang="en">(Elucidation) An occurrent is an entity that unfolds itself in time or it is the start or end of such an entity or it is a temporal or spatiotemporal region</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:example"/>
        <AbbreviatedIRI>obo:BFO_0000003</AbbreviatedIRI>
        <Literal xml:lang="en">As for process, history, process boundary, spatiotemporal region, zero-dimensional temporal region, one-dimensional temporal region, temporal interval, temporal instant.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
