    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>https://w3id.org/pmd/co/PMD_0020023</IRI>
        <Literal xml:lang="en">The metallic grain structures is a categorical value specification that specifies value of the  metallic grain structure quality. It describes the morphology of polycrystalline metallic materials. Polycrystalline metallic materials will typically form their grain structures as one of those categories or a transition or mixture state of those.</Literal>
    </AnnotationAssertion>
