        <AbbreviatedIRI>obo:BFO_0000004</AbbreviatedIRI>
        <Literal xml:lang="en">independent continuant</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>obo:BFO_0000004</AbbreviatedIRI>
        <Literal xml:lang="en">b is an independent continuant =Def b is a continuant &amp; there is no c such that b specifically depends on c or b generically depends on c</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:example"/>
        <AbbreviatedIRI>obo:BFO_0000004</AbbreviatedIRI>
        <Literal xml:lang="en">An atom; a molecule; an organism; a heart; a chair; the bottom right portion of a human torso; a leg; the interior of your mouth; a spatial region; an orchestra</Literal>
    </AnnotationAssertion>
