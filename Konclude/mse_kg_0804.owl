        <AnnotationProperty abbreviatedIRI="skos:example"/>
        <AbbreviatedIRI>ontology:NFDI_0000215</AbbreviatedIRI>
        <Literal xml:lang="en">Groovy on Grails, Angular</Literal>
    </AnnotationAssertion>
