    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>ontology:NFDI_0010001</AbbreviatedIRI>
        <Literal xml:lang="en">An academic discipline focused on human culture, thought, and creativity, encompassing disciplines like literature, philosophy, and the arts.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
