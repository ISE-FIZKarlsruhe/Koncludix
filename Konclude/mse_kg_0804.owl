        <Literal>various materials with matrix-inclusion morphology (containing, e.g., particles, fibers, whiskers) / microstructure data from experiments, simulations and abstract models</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250422"/>
        <Literal>Single- and polycrystalline materials/metals including superalloys and HEAs / Simulation data as well as postprocessed microscopy data</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250423"/>
        <Literal>Ni-based and Co-based single-crystal superalloys, metallic complex solid solutions / experiments and simulations</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250424"/>
        <Literal>Thermodynamic and Kinetics of Defects / Simulations and Experiments</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250425"/>
        <Literal>Joining processes and loaded joints (metals, FRP) / Experiments and Simulations</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250426"/>
        <Literal>Magnetoelectric composite materials; coupling of magnetic, electric and mechanical phenomena; Application to magnetoelectric sensors for medically relevant questions</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250427"/>
        <Literal>Functional magnetic and magnetocaloric materials / Additive manufacturing, artificial intelligence</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250428"/>
        <Literal>Composites between pure aluminum and iron and later alloys / MD simulations to study atomic interactions at interfaces, transfer to the continuum scale by multiscale simulations</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250429"/>
        <Literal>Synthetic and experimental inclusion-matrix and porous microstructures / image-based homogenization and uncertainty prediction</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17454164125043"/>
        <Literal>This TA develops Ontologies and metadata schemes in close cooperation with the stakeholders, tailored to their respective needs.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250430"/>
        <Literal>Polymers, functional materials, programmable materials / synthesis, additive manufacturing, simulations</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250431"/>
        <Literal>various materials / digital lab book, workflow management in the lab, knowledge system</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250432"/>
        <Literal>Long fiber reinforced polymers (thermoset and thermoplastic materials) / Real process chain is modeled and optimized by digital twin which is based on multi-scale characterization and simulation</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250433"/>
        <Literal>single and polycrystalline materials including superalloys, HEAs / Molekulardynamik (MD), Discrete Dislocation Dynamics (DDD), TEM</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250434"/>
        <Literal>Independent of a specific material/methodology. Supports teaching with a focus on using data science methods in MSE.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250435"/>
        <Literal>Mainly metallic materials, e.g. steels, aluminium alloys, Ti-6-4 / Atom Probe Tomography, nanoCT, FIB/SEM Tomography, Metallographic Serial Sectioning, Mechanical FE Simulation, Material Modeling.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250436"/>
        <Literal>Micromechanical and scale-bridging modeling of plastic deformation, fracture and fatigue of structural materials</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250437"/>
        <Literal>Nanoindentation raw data and analysis / Experiments</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250438"/>
        <Literal>Metallic alloys / Analysis of mechanical as well as physical properties and microstructure / Development of interactive visual data exploration and topological data analysis tools</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250439"/>
        <Literal>highly stressed metallic structural materials/ material, process and production engineering</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17454164125044"/>
        <Literal>This TA is responsible to stimulate the acceptance and vivid participation of the overall MSE community through communication, counselling, education / training and steady increase of the outreach.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250440"/>
        <Literal>High-Temperature metal alloys / Mechanical testing, Continuum Simulations</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250441"/>
        <Literal>physical standardization in metrology</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541641250442"/>
        <Literal>Al-alloys, fiber-composites / Fraunhofer Materials Ontology Stack for Methods and Processes</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17454164125045"/>
        <Literal>This TA is responsible for advancing the research in MSE by providing solutions for workflow management and software foundations that will improve both productivity and quality of the data processing and simulation aspects.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17454164125046"/>
        <Literal>Teaching</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17454164125047"/>
        <Literal>Single crystal Ni-based superalloys / Creep data</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17454164125048"/>
        <Literal>(mainly) metallic materials/tomographic data and related simulations with focus on large datasets</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17454164125049"/>
        <Literal>Mg-Al-Ca alloys / Thermodynamic and structural data of defects</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
