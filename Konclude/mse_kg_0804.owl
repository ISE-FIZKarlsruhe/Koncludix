    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541797019215"/>
        <Literal>Materials engineering at TU Kaiserslautern. Institute of Material Science and Engineering (WKK) + Institute of Visual Information Analysis (VIA)</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541797019216"/>
