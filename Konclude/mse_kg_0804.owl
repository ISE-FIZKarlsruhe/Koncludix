        <AbbreviatedIRI>obo:RO_0000079</AbbreviatedIRI>
        <Literal xml:lang="en">a relation between a function and an independent continuant (the bearer), in which the function specifically depends on the bearer for its existence</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000116"/>
        <AbbreviatedIRI>obo:RO_0000079</AbbreviatedIRI>
        <Literal xml:lang="en">A function inheres in its bearer at all times for which the function exists, however the function need not be realized at all the times that the function exists.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo:RO_0000079</AbbreviatedIRI>
        <Literal xml:lang="en">function of</Literal>
    </AnnotationAssertion>
