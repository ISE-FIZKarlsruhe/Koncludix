        <AbbreviatedIRI>ontology:NFDI_0010040</AbbreviatedIRI>
        <Literal>A software module is software composed of a collection of software methods.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>ontology:NFDI_0010040</AbbreviatedIRI>
        <Literal xml:lang="en">software module</Literal>
