    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17454179701921"/>
        <Literal>Focus on alloy design and performance improvement of Ni-based superalloys and Co-based single crystal super alloys with gamma / gamma prime microstructures. Improving processing technology. Obtain knowledge of materials properties and microstructure by implementing new test procedures of mechanical properties and characterization. Scalebridging materials modeling.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541797019210"/>
        <Literal>Ontology design for dislocations</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541797019211"/>
        <Literal>Data Science in MSE education, focused on students</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541797019212"/>
        <Literal>This Project collabration aims at demonstrating how scale-bridging tomographic data of a sample and derived mechanical simulations can be combined and made accessible in the sense of NFDI and FAIR criteria.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174541797019213"/>
