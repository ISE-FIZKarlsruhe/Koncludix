        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>ontology:NFDI_0000218</AbbreviatedIRI>
        <Literal xml:lang="en">Software that can be downloaded and executed locally on the users&apos; hardware.</Literal>
    </AnnotationAssertion>
