        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <AbbreviatedIRI>obo:BFO_0000004</AbbreviatedIRI>
        <Literal xml:lang="en">b is an independent continuant = Def. b is a continuant which is such that there is no c and no t such that b s-depends_on c at t. (axiom label in BFO2 Reference: [017-002])</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dce:identifier"/>
        <AbbreviatedIRI>obo:BFO_0000004</AbbreviatedIRI>
        <Literal>017-BFO</Literal>
