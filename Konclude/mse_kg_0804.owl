    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="ontology:NFDI_0010015"/>
        <AbbreviatedIRI>ontology:NFDI_0001009</AbbreviatedIRI>
        <Literal xml:lang="en">GND</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000118"/>
        <AbbreviatedIRI>ontology:NFDI_0001010</AbbreviatedIRI>
        <Literal xml:lang="en">Integrated Authority File</Literal>
