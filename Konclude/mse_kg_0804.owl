    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>mwo:MWO_0001000</AbbreviatedIRI>
        <Literal xml:lang="en">expert discussion</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>mwo:MWO_0001001</AbbreviatedIRI>
        <Literal>Event frequency datum describes how often an events occurs within a given time interval</Literal>
