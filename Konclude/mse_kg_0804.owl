        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17463807930073"/>
        <Literal>Standardization of materials ontology, including individualized materials ontologies for homegrown tools and workflows; Implementation of a knowledge graph to retrieve data based on their metadata</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty abbreviatedIRI="ontology:NFDI_0001007"/>
        <NamedIndividual IRI="https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17463807930074"/>
        <Literal>Ensure active participation and lively exchange of ideas, opinions, and experiences among researchers and associated stakeholders in the MSE community; Provide and conduct education and training for researchers, technical professionals, students; Planned TA-CI activities, including creating collaborative platforms, interactive workshops, and annual conferences</Literal>
    </DataPropertyAssertion>
