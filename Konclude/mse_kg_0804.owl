    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000112"/>
        <AbbreviatedIRI>obo:BFO_0000004</AbbreviatedIRI>
        <Literal xml:lang="en">a heart</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
