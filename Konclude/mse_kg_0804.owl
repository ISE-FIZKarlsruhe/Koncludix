        <AbbreviatedIRI>ontology:NFDI_0000214</AbbreviatedIRI>
        <IRI>https://doi.org/10.5281/zenodo.10101412</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>ontology:NFDI_0000214</AbbreviatedIRI>
        <Literal xml:lang="en">Service with direct user contact for topics going beyond the support for specific single services.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>ontology:NFDI_0000214</AbbreviatedIRI>
        <Literal xml:lang="en">support service</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>ontology:NFDI_0000215</AbbreviatedIRI>
        <Literal xml:lang="en">A plan specification that refers to a technology method employed for the creation, management, utilization, or control of a digital resource.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>ontology:NFDI_0000215</AbbreviatedIRI>
        <Literal xml:lang="en">technological method specification</Literal>
    </AnnotationAssertion>
