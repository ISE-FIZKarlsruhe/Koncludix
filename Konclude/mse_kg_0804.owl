        <Literal>knowledge about additive manufacturing processes</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174533026528383</IRI>
        <Literal>describes the life cycle of consensus-based standardization Project collabrations and published standardization deliverables</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174533026528384</IRI>
        <Literal>model the common aspects across the different characterisation methodologies</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
