        <AbbreviatedIRI>ontology:NFDI_0001010</AbbreviatedIRI>
        <Literal>https://viaf.org/en</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>ontology:NFDI_0001010</AbbreviatedIRI>
        <Literal xml:lang="en">The centrally registered identifier VIAF (Virtual International Authority File) is an international authority file that links and integrates authority records from multiple national libraries and other organizations. It provides a unique identifier for authors, creators, and entities, facilitating better data sharing and cataloging across institutions.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>ontology:NFDI_0001010</AbbreviatedIRI>
        <Literal xml:lang="en">VIAF identifier</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:example"/>
        <AbbreviatedIRI>ontology:NFDI_0001010</AbbreviatedIRI>
        <Literal>https://viaf.org/en/viaf/137346469</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
