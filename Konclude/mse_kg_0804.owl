        <Literal xml:lang="en">The inverse property of is specified input of</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000116"/>
        <AbbreviatedIRI>obo:OBI_0000293</AbbreviatedIRI>
        <Literal>8/17/09: specified inputs of one process are not necessarily specified inputs of a larger process that it is part of. This is in contrast to how &apos;has participant&apos; works.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
