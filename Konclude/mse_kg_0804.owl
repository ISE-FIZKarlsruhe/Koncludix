    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>ontology:NFDI_0010039</AbbreviatedIRI>
        <Literal>A software method (also called subroutine, subprogram, procedure, method, function, or routine) is software designed to execute a specific task.</Literal>
    </AnnotationAssertion>
