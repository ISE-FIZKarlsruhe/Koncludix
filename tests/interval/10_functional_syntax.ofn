Declaration(DataProperty(prov:endedAtTime))
DataPropertyAssertion(prov:startedAtTime :a "2026-01-01T08:00:00Z"^^xsd:dateTime)
DataPropertyAssertion(prov:endedAtTime :a "2026-01-01T10:00:00Z"^^xsd:dateTime)
DataPropertyAssertion(prov:startedAtTime :b "2026-01-01T11:00:00Z"^^xsd:dateTime)
DataPropertyAssertion(prov:endedAtTime :b "2026-01-01T12:00:00Z"^^xsd:dateTime)
ObjectPropertyAssertion(t:after :a :b)
