Prefix(:=<http://pmd.example/proc#>)
Prefix(prov:=<http://www.w3.org/ns/prov#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(<http://pmd.example/proc/rules-ok>
# Same rule as 11_rules_over_derived_relations.ofn, but both samples keep the order (test after machining): consistent.
Declaration(Class(:Machining))
Declaration(Class(:Test))
Declaration(ObjectProperty(:before))
Declaration(ObjectProperty(:after))
Declaration(ObjectProperty(:meets))
Declaration(ObjectProperty(:metBy))
Declaration(ObjectProperty(:overlaps))
Declaration(ObjectProperty(:overlappedBy))
Declaration(ObjectProperty(:starts))
Declaration(ObjectProperty(:startedBy))
Declaration(ObjectProperty(:during))
Declaration(ObjectProperty(:contains))
Declaration(ObjectProperty(:finishes))
Declaration(ObjectProperty(:finishedBy))
Declaration(ObjectProperty(:equals))
Declaration(ObjectProperty(:inSample))
Declaration(ObjectProperty(:notAfter))
InverseObjectProperties(:before :after)
InverseObjectProperties(:meets :metBy)
InverseObjectProperties(:overlaps :overlappedBy)
InverseObjectProperties(:starts :startedBy)
InverseObjectProperties(:during :contains)
InverseObjectProperties(:finishes :finishedBy)
SubObjectPropertyOf(:before :notAfter)
SubObjectPropertyOf(:meets :notAfter)
SubObjectPropertyOf(:overlaps :notAfter)
SubObjectPropertyOf(:overlappedBy :notAfter)
SubObjectPropertyOf(:starts :notAfter)
SubObjectPropertyOf(:startedBy :notAfter)
SubObjectPropertyOf(:during :notAfter)
SubObjectPropertyOf(:contains :notAfter)
SubObjectPropertyOf(:finishes :notAfter)
SubObjectPropertyOf(:finishedBy :notAfter)
SubObjectPropertyOf(:equals :notAfter)
SubClassOf(:Test ObjectAllValuesFrom(:notAfter ObjectComplementOf(:Machining)))
ClassAssertion(:Machining :machining1)
ClassAssertion(:Test :test1)
DataPropertyAssertion(prov:startedAtTime :machining1 "100"^^xsd:integer)
DataPropertyAssertion(prov:endedAtTime :machining1 "120"^^xsd:integer)
DataPropertyAssertion(prov:startedAtTime :test1 "130"^^xsd:integer)
DataPropertyAssertion(prov:endedAtTime :test1 "150"^^xsd:integer)
ObjectPropertyAssertion(:inSample :machining1 :sample1)
ObjectPropertyAssertion(:inSample :test1 :sample1)
ClassAssertion(:Machining :machining2)
ClassAssertion(:Test :test2)
DataPropertyAssertion(prov:startedAtTime :machining2 "200"^^xsd:integer)
DataPropertyAssertion(prov:endedAtTime :machining2 "220"^^xsd:integer)
DataPropertyAssertion(prov:startedAtTime :test2 "220"^^xsd:integer)
DataPropertyAssertion(prov:endedAtTime :test2 "230"^^xsd:integer)
ObjectPropertyAssertion(:inSample :machining2 :sample2)
ObjectPropertyAssertion(:inSample :test2 :sample2)
)
