Prefix(:=<http://uni.example/o#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Ontology(<http://uni.example/o>
Declaration(Class(:Person)) Declaration(Class(:Student)) Declaration(Class(:GradStudent)) Declaration(Class(:Course)) Declaration(Class(:Teacher))
Declaration(Class(:BusyPerson)) Declaration(Class(:Lecture)) Declaration(Class(:SeminarCourse)) Declaration(Class(:Department)) Declaration(Class(:ProjectGroup))
Declaration(ObjectProperty(:teaches)) Declaration(ObjectProperty(:taughtBy)) Declaration(ObjectProperty(:attends)) Declaration(ObjectProperty(:memberOf)) Declaration(ObjectProperty(:partOf))
AnnotationAssertion(rdfs:label :BusyPerson "busy person")
AnnotationAssertion(rdfs:label :GradStudent "graduate student")
AnnotationAssertion(rdfs:label :taughtBy "is taught by")
AnnotationAssertion(rdfs:label :teaches "teaches")
AnnotationAssertion(rdfs:label :attends "attends")
AnnotationAssertion(rdfs:label :memberOf "is a member of")
AnnotationAssertion(rdfs:label :partOf "is part of")
SubClassOf(:GradStudent :Student)
SubClassOf(:Student :Person)
SubClassOf(:Teacher :Person)
SubClassOf(:SeminarCourse :Course)
InverseObjectProperties(:teaches :taughtBy)
ObjectPropertyDomain(:teaches :Teacher)
ObjectPropertyRange(:teaches :Course)
TransitiveObjectProperty(:partOf)
SubObjectPropertyOf(:memberOf :partOf)
EquivalentClasses(:BusyPerson ObjectIntersectionOf(:Person ObjectMinCardinality(2 :attends :Course)))
EquivalentClasses(:ProjectGroup ObjectIntersectionOf(:Department ObjectSomeValuesFrom(:partOf :Department)))
DisjointClasses(:Course :Person)
ClassAssertion(:GradStudent :anna)
ClassAssertion(:Course :c1)
ClassAssertion(:Course :c2)
DifferentIndividuals(:c1 :c2)
ObjectPropertyAssertion(:taughtBy :c1 :bob)
ObjectPropertyAssertion(:attends :anna :c1)
ObjectPropertyAssertion(:attends :anna :c2)
ClassAssertion(:Department :cs)
ClassAssertion(:Department :faculty)
ClassAssertion(:Department :university)
ObjectPropertyAssertion(:memberOf :cs :faculty)
ObjectPropertyAssertion(:partOf :faculty :university)
ObjectPropertyAssertion(:teaches :carl :c2)
)
